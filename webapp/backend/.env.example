ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Journal storage (Supabase project, not the local journal.json file)
SUPABASE_URL=https://<project-ref>.supabase.co
# Use the service_role secret key, not the anon/publishable one — the
# journal table has RLS enabled with no anon/authenticated policies, so
# only service_role (server-side only, never exposed to the browser) can
# read or write it.
SUPABASE_SERVICE_ROLE_KEY=...
