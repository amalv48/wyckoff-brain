ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Journal + automation storage (Supabase project, not local files)
SUPABASE_URL=https://<project-ref>.supabase.co
# Use the service_role secret key, not the anon/publishable one — every
# table has RLS enabled with no anon/authenticated policies, so only
# service_role (server-side only, never exposed to the browser) can
# read or write them.
SUPABASE_SERVICE_ROLE_KEY=...

# Optional: automation push notifications. Without these, automation still
# runs and results still land in the Automation tab, just without a push.
# See README.md for how to obtain each.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
